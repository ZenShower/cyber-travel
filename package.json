{
  "name": "elsewhere-cyber-travel",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts src/*.test.ts",
    "test:land": "tsx --test server/land.test.ts",
    "serve": "NODE_ENV=production tsx server/index.ts",
    "doctor": "tsx scripts/doctor.ts",
    "audit:public": "node scripts/audit-public.mjs",
    "test:smoke": "tsx scripts/smoke.ts",
    "verify:ai": "tsx scripts/verify-ai.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.158.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "all-the-cities": "^3.1.0",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.11.2",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "vite": "^7.3.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "description": "在别处：让 AI 分身自己旅行，留下照片、日记与可翻页的相册。",
  "engines": {
    "node": ">=24 <25"
  }
}
